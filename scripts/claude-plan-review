#!/usr/bin/env bash
# Open the plan belonging to the Claude Code session in a herdr pane in
# plannotator-tui, delivering annotations back to that pane.
#
# pane -> claude pid (herdr pane process-info)
#      -> session id (~/.claude/sessions/<pid>.json)
#      -> transcript (~/.claude/projects/*/<session id>.jsonl)
#      -> slug (every transcript line carries it)
#      -> ~/.claude/plans/<slug>.md
#
# Usage: claude-plan-review [pane-id]   (default: herdr's active pane)
set -euo pipefail

# Run from a herdr key, stderr goes nowhere; keep a log.
log=~/.cache/claude-plan-review.log
mkdir -p "${log%/*}"
exec 2> >(tee -a "$log" >&2)
echo "$(date '+%F %T') start args=[$*] active_pane=${HERDR_ACTIVE_PANE_ID:-} pane=${HERDR_PANE_ID:-}" >&2

die() { echo "claude-plan-review: $*" >&2; exit 1; }

pane=${1:-${HERDR_ACTIVE_PANE_ID:-}}
if [[ -z $pane ]]; then
  pane=$(herdr pane list | jq -r '[.result.panes[] | select(.focused and .agent == "claude")][0].pane_id // empty')
fi
[[ -n $pane ]] || die "no pane given and no focused claude pane"

pid=$(herdr pane process-info --pane "$pane" \
  | jq -r '[.result.process_info.foreground_processes[] | select(.argv0 == "claude")][0].pid // empty')
[[ -n $pid ]] || die "no claude process in pane $pane"

session_file=~/.claude/sessions/$pid.json
[[ -f $session_file ]] || die "no session registry entry for pid $pid"
session_id=$(jq -r .sessionId "$session_file")

transcript=$(ls ~/.claude/projects/*/"$session_id".jsonl 2>/dev/null | head -1)
[[ -n $transcript ]] || die "no transcript for session $session_id"

slug=$(grep -o '"slug":"[^"]*"' "$transcript" | tail -1 | cut -d'"' -f4 || true)
[[ -n $slug ]] || die "no slug in $transcript"

plan=~/.claude/plans/$slug.md
[[ -f $plan ]] || die "session has no plan yet ($plan)"

# If the tab has an idle next-door shell pane, review there instead of splitting
# the Claude pane in two. `plannotator-tui herdr pane` is what herdr's plugin
# pane runs; it takes the file and delivery target from the environment, and on
# quit the pane drops back to its shell.
nd=$(~/.claude/skills/next-door/next-door --idle "$pane" 2>/dev/null || true)
if [[ -n $nd ]]; then
  echo "reviewing in next-door pane $nd" >&2
  herdr pane run "$nd" "PLANNOTATOR_TUI_FILE=$(printf %q "$plan") PLANNOTATOR_TUI_DELIVER_TO=$pane plannotator-tui herdr pane" >/dev/null
  # herdr focuses by direction, not ID; work out which side the pane is on.
  dir=$(herdr pane layout --pane "$pane" | jq -r --arg a "$pane" --arg b "$nd" '
    .result.layout.panes as $p
    | ([$p[] | select(.pane_id == $a)][0].rect) as $s
    | ([$p[] | select(.pane_id == $b)][0].rect) as $n
    | if   $n.x >= $s.x + $s.width  then "right"
      elif $n.x + $n.width <= $s.x  then "left"
      elif $n.y >= $s.y + $s.height then "down"
      else "up" end')
  exec herdr pane focus --pane "$pane" --direction "$dir" >/dev/null
fi

# Otherwise, if the tab is already split (a busy next-door pane, or several
# shells and none labelled), another split would squish it; use a popup.
placement=$(plannotator-tui config 2>/dev/null | sed -n 's/^placement = "\(.*\)"/\1/p')
tab=$(herdr pane get "$pane" | jq -r .result.pane.tab_id)
if (( $(herdr pane list | jq --arg t "$tab" '[.result.panes[] | select(.tab_id == $t)] | length') > 1 )); then
  placement=popup
fi

# Herdr key commands don't get HERDR_ENV, and plannotator-tui refuses to run without it.
HERDR_ENV=1 exec plannotator-tui herdr open "$plan" --deliver-to "$pane" --placement "${placement:-split}"
